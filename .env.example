# Copy this file to .env and fill in real values. Never commit .env itself.

MONGODB_URI=mongodb://localhost:27017/VexTrackerDB
MONGODB_DB_NAME=vextracker

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_your_jwt_secret

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key
